node_modules/
.env
.DS_Store

# Applicant-uploaded resumes are personal data, not project code -- keep the
# folder's own hardening tracked, but never commit what people upload to it.
public/uploads/*
!public/uploads/.htaccess

# Local DB dumps taken as safety snapshots during development -- not project
# code, and may contain real data.
database/local_backups/

# Cached PSGC (Philippine province/city/barangay) lookups -- refetched
# automatically by app/core/PsgcClient.php, not project code.
storage/cache/
